[Unit]
Description=Generate sanitized HomeLab status for Homepage
After=ssh.service tailscaled.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/export-homelab-status
ExecStart=/usr/local/sbin/export-homelab-alert-metrics
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/data/appdata/homelab-status /var/lib/node_exporter/textfile_collector
RestrictAddressFamilies=AF_UNIX

# No production .env, control token or OAuth credentials are needed here.
# Leave the camera blank for a recorded-video/map-only preparation.
# To test a real feed later, copy this file to .env.camera-staging (gitignored),
# supply its direct HTTP(S) URL and attest that reception/retransmission is allowed.
ISS_LIVE_CAMERA_URL=
ISS_LIVE_CAMERA_AUTHORIZED=false
ISS_LIVE_CAMERA_MODE=auto

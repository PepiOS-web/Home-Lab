PUID=1000
PGID=1000

# Dry-run blocks manual emission. If false, auto-start is still off by default;
# only the authenticated Homepage control can request a stream.
ISS_LIVE_DRY_RUN=true
ISS_LIVE_AUTO_START=false
ISS_LIVE_USE_NASA_PLAYLIST=true
ISS_LIVE_PRIVACY=unlisted
# Generate locally with: openssl rand -hex 32. Never share or commit the token.
ISS_LIVE_CONTROL_TOKEN=
ISS_LIVE_BLOCK_SECONDS=39000
ISS_LIVE_GAP_SECONDS=90
ISS_LIVE_MAX_BLOCKS=0
ISS_LIVE_MAP_SECONDS=120
ISS_LIVE_MAP_INTERVAL_SECONDS=600

# Direct, authorized HTTP(S)/HLS input. Do not put a YouTube watch-page URL here.
ISS_LIVE_SOURCE_URL=
ISS_LIVE_SOURCE_LABEL=NASA Space Station Views
ISS_LIVE_NASA_PLAYLIST=/data/nasa/videos/playlist.ffconcat
ISS_LIVE_NASA_LOOP_VIDEO=/data/nasa/videos/astrolearner-nasa-loop.mp4
ISS_LIVE_POSITION_URL=https://api.wheretheiss.at/v1/satellites/25544

ISS_LIVE_WIDTH=1280
ISS_LIVE_HEIGHT=720
ISS_LIVE_FPS=12
ISS_LIVE_ENCODER=libx264
ISS_LIVE_VIDEO_BITRATE=4500k
ISS_LIVE_VIDEO_BUFSIZE=9000k
ISS_LIVE_AUDIO_BITRATE=128k
ISS_LIVE_MUSIC_VOLUME=4

# OAuth files live outside the repository and are mounted read-only/read-write.
ISS_LIVE_YOUTUBE_CLIENT_SECRET=/run/secrets/youtube-client-secret.json
ISS_LIVE_YOUTUBE_TOKEN=/data/secrets/youtube-token.json

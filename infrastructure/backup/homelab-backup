#!/usr/bin/env bash
set -Eeuo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

backup_dir="/srv/data/backups/daily"
backup_stamp=$(date -u +%Y%m%d-%H%M%S)
archive_name="homelab-${backup_stamp}.tar.gz"
archive="${backup_dir}/${archive_name}"
temporary="${archive}.part"
declare -a running_containers=()

restart_containers() {
    if [ "${#running_containers[@]}" -gt 0 ]; then
        echo "Reiniciando contenedores..."
        /usr/bin/docker start "${running_containers[@]}" >/dev/null || true
        running_containers=()
    fi
}

cleanup() {
    exit_code=$?
    trap - EXIT
    restart_containers
    /bin/rm -f -- "$temporary"
    exit "$exit_code"
}

trap cleanup EXIT

install -d -m 700 "$backup_dir"

echo "Deteniendo servicios con datos persistentes..."
mapfile -t running_containers < <(/usr/bin/docker ps --format '{{.Names}}')
if [ "${#running_containers[@]}" -gt 0 ]; then
    /usr/bin/docker stop "${running_containers[@]}" >/dev/null
fi

echo "Creando ${archive_name}..."
/usr/bin/tar --acls --xattrs -czf "$temporary" \
    /srv/data/appdata \
    /srv/data/compose \
    /usr/local/sbin/export-homelab-temperatures \
    /usr/local/sbin/export-homelab-status \
    /usr/local/sbin/export-homelab-alert-metrics \
    /usr/local/sbin/homelab-backup \
    /etc/systemd/system/homelab-temperatures.service \
    /etc/systemd/system/homelab-temperatures.timer \
    /etc/systemd/system/homelab-status.service \
    /etc/systemd/system/homelab-status.timer \
    /etc/systemd/system/homelab-backup.service \
    /etc/systemd/system/homelab-backup.timer \
    /etc/ssh/sshd_config \
    /etc/ssh/sshd_config.d \
    /etc/ufw \
    /etc/sysctl.d/99-tailscale.conf \
    /etc/apt/sources.list.d/tailscale.list \
    /etc/apt/apt.conf.d/52-homelab-unattended-upgrades \
    /usr/share/keyrings/tailscale-archive-keyring.gpg

/bin/mv "$temporary" "$archive"
/bin/chmod 600 "$archive"

echo "Iniciando servicios..."
restart_containers

echo "Generando y verificando SHA-256..."
(
    cd "$backup_dir"
    /usr/bin/sha256sum "$archive_name" > "${archive_name}.sha256"
    /bin/chmod 600 "${archive_name}.sha256"
    /usr/bin/sha256sum -c "${archive_name}.sha256"
)

echo "Eliminando copias diarias con mas de siete dias..."
/usr/bin/find "$backup_dir" -maxdepth 1 -type f \
    \( -name 'homelab-*.tar.gz' -o -name 'homelab-*.tar.gz.sha256' \) \
    -mtime +7 -delete

echo "Backup completado: ${archive}"
